	<update id="markCommentEvaluatedIfNotEvaluated">
		UPDATE order_info
		SET comment_status = 1
		WHERE order_id = #{orderId}
		  AND user_id = #{userId}
		  AND comment_status = 0
	</update>

	<update id="revertCommentStatusIfEvaluated">
		UPDATE order_info
		SET comment_status = 0
		WHERE order_id = #{orderId}
		  AND comment_status = 1
	</update>

