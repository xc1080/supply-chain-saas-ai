# Simlect 生产环境变量模板
# 复制为 .env 或注入到 systemd/K8s；上线必须设置 SIMLECT_PRODUCTION_READY=true
#
# 完整版（中间件 + 微服务全开）推荐宿主机内存 ≥16G（32G 更从容）；详见 deploy/FULL_STACK.md

# ---- 总开关 ----
SIMLECT_PRODUCTION_READY=true
SIMLECT_DEV_LOGIN_BYPASS=false

# ---- 基础设施 ----
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
MYSQL_HOST=127.0.0.1
MYSQL_USER=simlect
MYSQL_PASSWORD=CHANGE_ME_STRONG
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=simlect
RABBIT_PASSWORD=CHANGE_ME_STRONG
RABBIT_VHOST=/
SENTINEL_DASHBOARD=127.0.0.1:8858
ES_URIS=http://127.0.0.1:9200

# ---- 服务间安全（全服务必须一致）----
SIMLECT_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# ---- 管理端 ----
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG
ADMIN_EMAILS=ops@example.com

# ---- 业务 ----
PROJECT_FOLDER=/data/simlect/upload
PROJECT_DOMAIN=https://www.example.com
ORDER_EXPIRE_MINUTE=15
ORDER_CONFIRM_MINUTE=10080

# ---- 支付宝（支付必填）----
ALIPAY_APPID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_CERT_PATH=/data/simlect/certs/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=/data/simlect/certs/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=/data/simlect/certs/alipayRootCert.crt
ALIPAY_SERVER_URL=https://openapi.alipay.com/gateway.do

# ---- 可选能力 ----
AMAP_KEY=
BAIDU_AIP_ENABLED=false
BAIDU_AIP_API_KEY=
BAIDU_AIP_SECRET_KEY=

# ---- 搜索 / RAG（search 服务）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
EMBEDDING_MODEL=text-embedding-v4
VECTOR_INDEX=simlect_vectorstore

# ---- Agent（Python）----
AGENT_HOST=127.0.0.1
AGENT_PORT=7050
JAVA_WEB_URL=http://127.0.0.1:8080
MCP_SERVER_URL=http://127.0.0.1:7060
APP_PORT=7050
ES_INDEX=simlect_vectorstore
