// Verification only: Linux, JDK 17, Maven, Python 3.12, Node 24, mysql and Docker Compose.
pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    stages {
        stage('Verify active application and isolated MySQL closure') {
            steps {
                script {
                    if (!isUnix()) { error('This verification entry requires a Linux agent') }
                    if (!fileExists('scripts/verify-ci.sh')) { error('Check out the learning repository root') }
                }
                sh 'bash scripts/verify-ci.sh'
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'ks-inventory-system/**/target/surefire-reports/*.xml,ks-inventory-system/**/target/failsafe-reports/*.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'logs/engineering-ci/**/*.json,logs/engineering-ci/**/*.log'
        }
    }
}
