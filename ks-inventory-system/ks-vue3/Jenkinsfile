// Compatibility entry for the retired standalone frontend deployment.
// Configure this Jenkins job to check out the learning repository root.
pipeline {
    agent any
    options { timestamps(); disableConcurrentBuilds(); timeout(time: 60, unit: 'MINUTES') }
    stages {
        stage('Run unified engineering verification') {
            steps {
                script {
                    if (!isUnix() || !fileExists('scripts/verify-ci.sh')) {
                        error('Use a Linux agent and repository root; standalone automatic frontend deployment is retired')
                    }
                }
                sh 'bash scripts/verify-ci.sh'
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'ks-inventory-system/**/target/surefire-reports/*.xml,ks-inventory-system/**/target/failsafe-reports/*.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'logs/engineering-ci/**/*.json,logs/engineering-ci/**/*.log'
        }
    }
}
